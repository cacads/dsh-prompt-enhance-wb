{
  "name": "dsh-prompt-enhance-wb",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Composer prompt enhancement for the DSH web GUI, built on the prompt WorkBuddy ships for its own enhance button, with a fidelity gate, a two-sided length gate, a model chain with retry, cancel/progress, and per-session state.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "CHANGELOG.md",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1"
  }
}


